<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.my.family.shop.mapper.ProductMapper">

    <!--
      商品表映射配置
      数据库表：t_product
    -->
    <resultMap id="ProductResultMap" type="com.my.family.shop.domain.entity.ProductDO">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="category" property="category"/>
        <result column="product_name" property="productName"/>
        <result column="product_desc" property="productDesc"/>
        <result column="stock" property="stock"/>
        <result column="price" property="price"/>
        <result column="image_url" property="imageUrl"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!--
      通用查询字段
    -->
    <sql id="Base_Column_List">
        id, product_id, category, product_name, product_desc, stock, price, image_url, status, deleted, create_time, update_time
    </sql>

    <!--
      新增商品
    -->
    <insert id="insert" parameterType="com.my.family.shop.domain.entity.ProductDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_product (
            product_id, category, product_name, product_desc, stock, price, image_url, status, deleted, create_time, update_time
        ) VALUES (
            #{productId}, #{category}, #{productName}, #{productDesc}, #{stock}, #{price}, #{imageUrl}, #{status}, #{deleted}, #{createTime}, #{updateTime}
        )
    </insert>

    <!--
      根据主键ID更新商品信息
    -->
    <update id="updateById" parameterType="com.my.family.shop.domain.entity.ProductDO">
        UPDATE t_product
        <set>
            <if test="productId != null">
                product_id = #{productId},
            </if>
            <if test="category != null and category != ''">
                category = #{category},
            </if>
            <if test="productName != null and productName != ''">
                product_name = #{productName},
            </if>
            <if test="productDesc != null">
                product_desc = #{productDesc},
            </if>
            <if test="stock != null">
                stock = #{stock},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="imageUrl != null">
                image_url = #{imageUrl},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="deleted != null">
                deleted = #{deleted},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime}
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!--
      根据商品ID（业务编号）查询商品信息
    -->
    <select id="selectByProductId" parameterType="java.lang.Long" resultMap="ProductResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_product
        WHERE product_id = #{productId}
        AND deleted = 0
        LIMIT 1
    </select>

    <!--
      查询当前未删除商品中最大的商品ID（product_id）
    -->
    <select id="selectMaxProductId" resultType="java.lang.Long">
        SELECT MAX(product_id)
        FROM t_product
        WHERE deleted = 0
    </select>

    <!--
      分页查询商品列表
      支持按类别、名称模糊、价格区间、状态筛选
    -->
    <select id="selectPage" resultMap="ProductResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_product
        <where>
            deleted = 0
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="productName != null and productName != ''">
                AND product_name LIKE CONCAT('%', #{productName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="minPrice != null">
                AND price &gt;= #{minPrice}
            </if>
            <if test="maxPrice != null">
                AND price &lt;= #{maxPrice}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>


